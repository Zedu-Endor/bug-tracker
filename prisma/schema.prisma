generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Severity {
  low
  medium
  high
  critical
}

enum Status {
  open
  in_progress
  resolved
  closed
}

/// Application roles for RBAC.
/// - user: default; report bugs, comment, vote
/// - admin: triage bugs (status / severity / assignee)
/// - super_admin: all admin powers + manage user roles
enum Role {
  user
  admin
  super_admin
}

enum ActivityType {
  created
  status_changed
  severity_changed
  assignee_changed
  commented
  edited
  milestone_changed
  boosted
  unboosted
  deleted
  restored
  comment_deleted
  type_changed
  category_changed
  duplicate_changed
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  /// Null for Google-only accounts; required for credentials login/signup.
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  role          Role          @default(user)
  /// Email when mentioned, assigned, or when an issue you reported changes status (#151).
  /// Master switch. The notify* flags below pick which kinds when it is on.
  emailNotifications Boolean  @default(true)
  notifyMentions     Boolean       @default(true)
  notifyAssignments  Boolean       @default(true)
  notifyStatusChanges Boolean      @default(true)
  /// Bumped on password reset; JWTs carrying an older value are rejected (#208).
  sessionVersion Int          @default(0)
  createdAt     DateTime      @default(now())
  reportedBugs  Bug[]         @relation("BugReporter")
  assignedBugs  Bug[]         @relation("BugAssignee")
  attachments   Attachment[]
  comments            Comment[]
  votes               Vote[]
  activities          BugActivity[]
  bugRevisions        BugRevision[]
  passwordResetTokens PasswordResetToken[]
  watches             IssueWatch[]
  notifications       Notification[]
}

/// Single-use password reset tokens (~30 min TTL). Store only the SHA-256 hash.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IssueType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// Markdown that pre-fills the report form's description (#307). Null: none.
  template    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bugs        Bug[]
}

model Bug {
  id          String        @id @default(cuid())
  /// Human-readable reference (#1, #2, ...), assigned by a Postgres sequence.
  number      Int           @unique @default(autoincrement())
  title       String
  description String
  severity    Severity      @default(medium)
  status      Status        @default(open)
  typeId      String?
  type        IssueType?    @relation(fields: [typeId], references: [id], onDelete: SetNull)
  voteCount   Int           @default(0)
  isBoosted   Boolean       @default(false)
  boostedAt   DateTime?
  /// #289: at most one milestone. Cleared, not cascaded, when it's deleted.
  milestoneId String?
  milestone   Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  isDeleted   Boolean       @default(false)
  deletedAt   DateTime?
  proofLinks  String[]      @default([])
  reporterId  String
  assigneeId  String?
  categoryId  String?
  /// #285: set when this issue is a duplicate of another. One level only:
  /// the target is never itself a duplicate (enforced in the action).
  duplicateOfId String?
  duplicateOf   Bug?        @relation("BugDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Bug[]       @relation("BugDuplicates")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  reporter    User          @relation("BugReporter", fields: [reporterId], references: [id])
  assignee    User?         @relation("BugAssignee", fields: [assigneeId], references: [id])
  attachments Attachment[]
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  comments    Comment[]
  votes       Vote[]
  watches       IssueWatch[]
  notifications Notification[]
  activities  BugActivity[]
  revisions   BugRevision[]

  @@index([categoryId])
  @@index([typeId])
  @@index([duplicateOfId])
  @@index([isBoosted])
  @@index([isDeleted])
  @@index([milestoneId])
  // #217: foreign keys behind the "Assigned to me" / "Reported by me" filters.
  @@index([assigneeId])
  @@index([reporterId])
  // #217: match getBugOrderBy() exactly (boosted first, then the chosen sort),
  // so the list can be read in index order instead of sorting every row.
  @@index([isDeleted, isBoosted(sort: Desc), boostedAt(sort: Desc), voteCount(sort: Desc), updatedAt(sort: Desc), createdAt(sort: Desc)], map: "Bug_list_top_votes_idx")
  @@index([isDeleted, isBoosted(sort: Desc), boostedAt(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "Bug_list_newest_idx")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bugs      Bug[]
}

/// A release or sprint grouping issues (#289).
model Milestone {
  id          String    @id @default(cuid())
  title       String    @unique
  description String?
  /// A calendar day; no time of day.
  dueDate     DateTime? @db.Date
  /// Closing a milestone leaves its issues alone.
  isClosed    Boolean   @default(false)
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bugs        Bug[]

  @@index([isClosed, dueDate])
}

model BugActivity {
  id        String       @id @default(cuid())
  bugId     String
  actorId   String
  type      ActivityType
  summary   String
  metadata  Json?
  createdAt DateTime     @default(now())
  bug       Bug          @relation(fields: [bugId], references: [id], onDelete: Cascade)
  actor     User         @relation(fields: [actorId], references: [id])

  @@index([bugId, createdAt])
}

/// A title + description an edit replaced (#303). The issue row holds the
/// current version; these are the ones before it.
model BugRevision {
  id          String   @id @default(cuid())
  bugId       String
  title       String
  description String
  /// Who made the edit that replaced this version. Null if since deleted.
  editedById  String?
  editedAt    DateTime @default(now())
  bug         Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  editedBy    User?    @relation(fields: [editedById], references: [id], onDelete: SetNull)

  @@index([bugId, editedAt])
}

model Comment {
  id        String    @id @default(cuid())
  bugId     String
  authorId  String
  parentId  String?
  body      String
  createdAt DateTime  @default(now())
  /// Set when the author edits the comment; shown as "edited".
  editedAt  DateTime?
  /// Soft delete: the body is cleared and replies keep their place.
  deletedAt DateTime?
  bug       Bug       @relation(fields: [bugId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([bugId])
  @@index([bugId, createdAt])
  @@index([parentId])
  attachments Attachment[]
}

/// Files attached to an issue or a comment (#215): screenshots, logs, PDFs,
/// HAR files. Stored in Postgres (max 5 MB, checked in lib/attachments.ts)
/// and only served to signed-in users. Uploaded first, then linked to the
/// issue or comment when it's saved; until then only the uploader can see it.
model Attachment {
  id          String   @id @default(cuid())
  uploaderId  String
  bugId       String?
  commentId   String?
  filename    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  bug         Bug?     @relation(fields: [bugId], references: [id], onDelete: Cascade)
  comment     Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([bugId])
  @@index([commentId])
  @@index([uploaderId, createdAt])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  bugId     String
  value     Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@unique([userId, bugId])
  @@index([bugId])
}

/// Who follows an issue (#216). People are watching by default when they
/// report, are assigned to or comment on an issue; `watching = false` records
/// an explicit "Unwatch" so they aren't added back automatically.
model IssueWatch {
  userId    String
  bugId     String
  watching  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)

  @@id([userId, bugId])
  @@index([bugId])
}

/// In-app notification feed (#216): one row per person per event, written
/// whether or not email is configured or wanted.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  bugId     String?
  /// Event kind, e.g. "comment_added", "mentioned", "status_changed".
  kind      String
  title     String
  /// App-relative link, e.g. /bugs/<id>#comment-<id>.
  url       String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bug       Bug?      @relation(fields: [bugId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// Sliding-window rate-limit attempts, shared by every app instance (#296).
/// `key` is a SHA-256 of the limiter key (it contains emails and IPs); `at`
/// is epoch milliseconds. Rows older than the longest window are deleted.
model RateLimitHit {
  id  BigInt @id @default(autoincrement())
  key String
  at  BigInt

  @@index([key, at])
}
