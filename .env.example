# Database Connection:
# - Local dev: Docker Compose postgres service on port 5433 (`docker compose up -d`)
# - Production (Coolify): PostgreSQL service configured in Coolify
DATABASE_URL="postgresql://bugtracker:bugtracker@localhost:5433/bugtracker?schema=public"

# Auth.js Secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Auth.js Base URL (full auth endpoint including /bug-tracker/api/auth):
# Local development:
AUTH_URL="http://localhost:3001/bug-tracker/api/auth"
NEXTAUTH_URL="http://localhost:3001/bug-tracker/api/auth"
# Production (Coolify):
# AUTH_URL="https://contributors.zedu.chat/bug-tracker/api/auth"
# NEXTAUTH_URL="https://contributors.zedu.chat/bug-tracker/api/auth"

# Email/password sign-in (plus forgot/reset password). Zedu Bugs is Google-only
# in production, so this defaults to OFF when NODE_ENV=production and ON in
# local dev (needed for the demo seed logins). Set "true" / "false" to override.
# AUTH_PASSWORD_LOGIN=

# Optional. Google Form opened by the floating "Report issue" button in the
# bottom-right corner. Only https:// links on Google-owned hosts are accepted
# (docs.google.com, forms.gle); anything else leaves the button hidden.
# REPORT_FORM_URL="https://docs.google.com/forms/d/e/<FORM_ID>/viewform"

# Optional Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI in Google Console:
# https://contributors.zedu.chat/bug-tracker/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Super admin email (defaults to amicablembakara50@gmail.com).
# Anyone signing in via Google with this email is automatically granted the super_admin role.
SUPER_ADMIN_EMAIL="amicablembakara50@gmail.com"
SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_NAME="Super Admin"
# Set to "true" to rotate password / promote an existing account to super_admin
# SUPER_ADMIN_FORCE_UPDATE=false
# Set to "true" to wipe users/bugs and load demo data (empty DB seeds demo by default)
# SEED_DEMO_DATA=true

# Optional SMTP for password-reset emails (AUTH LOGIN + STARTTLS).
# When unset, reset links are logged to the server console (dev-friendly).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Zedu Bugs <noreply@example.com>"
